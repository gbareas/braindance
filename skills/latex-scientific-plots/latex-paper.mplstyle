# Publication-ready matplotlib style: LaTeX text, journal sizes, colorblind-safe colors.
# Use with: plt.style.use("latex-paper.mplstyle")

# --- Text: LaTeX, serif, Computer Modern ---
text.usetex        : True
font.family        : serif
font.serif         : Computer Modern Roman, CMU Serif, DejaVu Serif
mathtext.fontset   : cm
axes.formatter.use_mathtext : True
axes.unicode_minus : True

# --- Font sizes (pt), matching 9-10 pt journal text ---
font.size          : 9
axes.labelsize     : 9
axes.titlesize     : 9
xtick.labelsize    : 8
ytick.labelsize    : 8
legend.fontsize    : 8
figure.titlesize   : 9

# --- Figure: single-column default, golden ratio ---
figure.figsize     : 3.4, 2.1
figure.dpi         : 150
figure.constrained_layout.use : True

# --- Colors: Okabe-Ito colorblind-safe cycle ---
axes.prop_cycle    : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', '000000', 'F0E442'])
image.cmap         : viridis

# --- Lines and markers ---
lines.linewidth    : 1.2
lines.markersize   : 3.5
errorbar.capsize   : 2

# --- Axes ---
axes.linewidth     : 0.6
axes.grid          : False
axes.titlepad      : 4
axes.labelpad      : 2

# --- Ticks: inward, all sides, minor ticks on ---
xtick.direction    : in
ytick.direction    : in
xtick.top          : True
ytick.right        : True
xtick.minor.visible : True
ytick.minor.visible : True
xtick.major.size   : 3.5
ytick.major.size   : 3.5
xtick.minor.size   : 2
ytick.minor.size   : 2
xtick.major.width  : 0.6
ytick.major.width  : 0.6
xtick.minor.width  : 0.5
ytick.minor.width  : 0.5

# --- Legend ---
legend.frameon     : False
legend.handlelength : 1.8
legend.borderaxespad : 0.4

# --- Export: vector PDF with embedded fonts ---
savefig.format     : pdf
savefig.dpi        : 600
savefig.bbox       : tight
savefig.pad_inches : 0.02
pdf.fonttype       : 42
ps.fonttype        : 42
